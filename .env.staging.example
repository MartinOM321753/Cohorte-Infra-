# Cohorte-Infra — plantilla de variables de entorno (STAGING / PRUEBAS)
#
# Este archivo se sube a Jenkins como credencial tipo "Secret file" con ID
# "cohorte-env-file-staging". El pipeline lo copia al workspace como .env cuando
# se ejecuta con el parametro DEPLOY_ENV=staging.
#
# Diferencias clave respecto a produccion, TODAS deliberadas para que los dos
# ambientes no se toquen entre si:
#   - Prefijo, red y volumenes propios  → datos completamente aislados
#   - Puertos de administracion propios → no colisionan en 127.0.0.1
#   - Etiquetas de imagen propias       → un build de staging no sobreescribe
#                                          la imagen que produccion esta usando
#   - Correo desactivado por defecto    → staging no manda correos a usuarios reales

# ── Identidad del ambiente ────────────────────────────────────────────────────
CONTAINER_PREFIX=cohorte-staging

INTERNAL_NET=cohorte-staging-net
DB_VOLUME=cohorte-staging-volume
MINIO_VOLUME=minio-staging-volume

APP_DOMAIN=staging.hwcs.cipps.unam.mx

DB_HOST_PORT=3308
BACKEND_HOST_PORT=8082
MINIO_API_HOST_PORT=9002
MINIO_CONSOLE_HOST_PORT=9003

BACKEND_IMAGE=server:1.0-cohorte-staging
FRONTEND_IMAGE=web:1.0-cohorte-staging

# ── Base de datos ─────────────────────────────────────────────────────────────
# Usa credenciales DISTINTAS a las de produccion. Que staging tenga su propia
# contrasena evita que una fuga en pruebas comprometa la base real.
DB_USER_NAME=root
DB_PASSWORD=cambia-esta-contrasena-de-staging

# ── MinIO (almacenamiento de objetos) ─────────────────────────────────────────
MINIO_ACCESS_KEY=cambia-este-usuario-de-staging
MINIO_SECRET_KEY=cambia-esta-contrasena-de-staging
MINIO_BUCKET=cohorte-docs

# ── JWT ───────────────────────────────────────────────────────────────────────
# Clave PROPIA de staging: un token emitido en pruebas nunca debe ser valido en
# produccion. Genera una nueva con: openssl rand -base64 32
SECRET_KEY=genera-una-clave-base64-distinta-a-la-de-produccion

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Desactivado a proposito: evita que una prueba dispare correos de invitacion o
# de reset a participantes y usuarios reales. Ponlo en true solo si necesitas
# probar el flujo de correo, y de preferencia contra un buzon de pruebas.
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=staging@tu-dominio.com

# ── URL pública del frontend (usada en emails y CORS del backend) ─────────────
FRONTEND_URL=https://staging.hwcs.cipps.unam.mx

# ── Cookies de sesión ──────────────────────────────────────────────────────────
# true: Traefik sirve staging por HTTPS igual que produccion.
COOKIE_SECURE=true

# ── Perfil de Spring activo en el backend ──────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Frontend build (Vite — baked en tiempo de build del contenedor) ───────────
VITE_API_URL=/api
