# Almacen de instrumentos (MinIO publico) -- plantilla de variables de entorno
# Copiar como ".env" en ESTE mismo directorio (minio-public/.env) y completar.
# NUNCA subir el .env real al repositorio -- ya esta cubierto por .gitignore.
#
# En el servidor lo genera el pipeline a partir de la credencial de Jenkins
# "minio-public-env-file" (tipo Secret file). Ver README.md de este directorio.

# ── Dominio y ruta publica ────────────────────────────────────────────────────
# Host del que cuelga el bucket. HOY es el de staging porque no hay subdominio
# propio disponible. El dia que exista (ej. files.hwcs.cipps.unam.mx) se cambia
# SOLO esta linea y se vuelve a levantar el stack; las URLs conservan la misma
# forma porque el bucket va en la ruta en cualquier caso.
MINIO_PUBLIC_HOST=staging.hwcs.cipps.unam.mx

# Nombre del bucket. OJO: es tambien el prefijo de ruta publico, asi que
#   - no se puede renombrar sin reemitir todas las URLs ya repartidas, y
#   - ninguna ruta del SPA (Cohorte-front) puede llamarse igual.
# Con los valores de arriba, una imagen queda en:
#   https://staging.hwcs.cipps.unam.mx/archivos-instrumentos/INS-042/frontal.jpg
MINIO_PUBLIC_BUCKET=archivos-instrumentos

# ── Credenciales ──────────────────────────────────────────────────────────────
# Cuenta raiz: SOLO para administrar (altas de usuarios, revisar el bucket).
# No se reparte y no se usa para subir archivos.
# DEBE ser distinta de MINIO_ACCESS_KEY/MINIO_SECRET_KEY del .env de la
# aplicacion: si se reutilizan, una fuga de este servicio es una fuga del sistema.
# Generar, por ejemplo, con: openssl rand -base64 24
MINIO_PUBLIC_ROOT_USER=cambia-este-usuario-raiz
MINIO_PUBLIC_ROOT_PASSWORD=cambia-esta-contrasena-raiz

# Usuario de subida: es el que se configura en rclone para montar la unidad de
# red en cada PC. Queda acotado por politica al bucket de arriba y no ve ningun
# otro. Para dar de alta a mas personas (una credencial por equipo, para poder
# revocarlas por separado), ver README.md de este directorio.
MINIO_PUBLIC_UPLOADER_USER=instrumentos-upload
MINIO_PUBLIC_UPLOADER_PASSWORD=cambia-esta-contrasena-de-subida

# ── Limites y retencion ───────────────────────────────────────────────────────
# Cuota del bucket: al alcanzarla, MinIO rechaza escrituras nuevas en vez de
# dejar sin espacio al disco que tambien aloja MySQL y los dos ambientes.
MINIO_PUBLIC_QUOTA=50gb

# El bucket tiene versionado activo (un borrado accidental desde la unidad de
# red se puede deshacer). Esta variable define cuantos dias se conservan las
# versiones antiguas antes de purgarse, para que el versionado no crezca sin fin.
MINIO_PUBLIC_NONCURRENT_DAYS=30

# ── Infraestructura ───────────────────────────────────────────────────────────
# Volumen externo con los datos. El pipeline lo crea si falta.
MINIO_PUBLIC_VOLUME=minio-public-volume

# Puertos publicados en 127.0.0.1 (solo administracion local via SSH tunnel).
# 9000/9001 son de produccion y 9002/9003 de staging: no reutilizarlos.
MINIO_PUBLIC_API_PORT=9004
MINIO_PUBLIC_CONSOLE_PORT=9005
