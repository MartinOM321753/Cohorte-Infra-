# Cohorte-Infra — plantilla de variables de entorno (PRODUCCIÓN)
# Copia este archivo como ".env" (mismo directorio que docker-compose.yml) y
# completa los valores reales. NUNCA subas ".env" al repositorio — ya esta en .gitignore.
#
# En Jenkins, este archivo NO se versiona con valores reales: el pipeline lo genera
# en el workspace a partir de credenciales configuradas en Jenkins (ver README.md).
#
# Para el ambiente de pruebas, ver .env.staging.example.

# ── Identidad del ambiente ────────────────────────────────────────────────────
# Prefijo de los nombres de contenedor. En produccion debe quedarse en "cohorte":
# el script de respaldo y el cron diario buscan el contenedor "cohorte-database".
CONTAINER_PREFIX=cohorte

# Red y volumenes externos de este ambiente (el pipeline los crea si faltan).
INTERNAL_NET=cohorte-net
DB_VOLUME=cohorte-volume
MINIO_VOLUME=minio-volume

# Dominio publico. Traefik enruta por este valor: la peticion que llegue con este
# Host se entrega al frontend de este ambiente, y el certificado TLS se emite
# para el mismo nombre.
APP_DOMAIN=hwcs.cipps.unam.mx

# Puertos publicados en 127.0.0.1 para administracion local (SSH tunnel).
# Nunca son publicos. Deben ser distintos en cada ambiente para no colisionar.
DB_HOST_PORT=3307
BACKEND_HOST_PORT=8081
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Etiquetas de imagen. Distintas por ambiente para que un build de staging no
# sobreescriba la imagen que produccion tiene en ejecucion.
BACKEND_IMAGE=server:1.0-cohorte
FRONTEND_IMAGE=web:1.0-cohorte

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_USER_NAME=root
DB_PASSWORD=root

# ── MinIO (almacenamiento de objetos) ─────────────────────────────────────────
MINIO_ACCESS_KEY=cambia-este-usuario
MINIO_SECRET_KEY=cambia-esta-contrasena
MINIO_BUCKET=cohorte-docs

# ── JWT ───────────────────────────────────────────────────────────────────────
# Genera una clave nueva, ej: openssl rand -base64 32
SECRET_KEY=genera-una-clave-base64-de-256-bits

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
MAIL_ENABLED=true
MAIL_USERNAME=tu-usuario-smtp
MAIL_PASSWORD=tu-password-smtp
MAIL_FROM=notificaciones@tu-dominio.com

# ── URL pública del frontend (usada en emails y CORS del backend) ─────────────
FRONTEND_URL=https://hwcs.cipps.unam.mx

# ── Cookies de sesión ──────────────────────────────────────────────────────────
# true en produccion (requiere HTTPS); false solo para depurar en HTTP local.
COOKIE_SECURE=true

# ── Perfil de Spring activo en el backend ──────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Frontend build (Vite — baked en tiempo de build del contenedor) ───────────
# /api → nginx del contenedor frontend proxía al backend (Docker)
VITE_API_URL=/api

# ── Nota sobre TLS ─────────────────────────────────────────────────────────────
# Ya no hay variables de Certbot: los certificados los emite y renueva Traefik
# automaticamente. El correo de avisos de Let's Encrypt se configura una sola vez
# en traefik/.env (ver traefik/.env.example).
